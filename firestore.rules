rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/private/library {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/saves/{slot} {
      allow read, delete: if owner(uid) && slot in ['1','2','3'];
      allow create, update: if owner(uid) && slot in ['1','2','3']
        && request.resource.data.keys().hasOnly(['label','name','type','size','data'])
        && request.resource.data.label is string && request.resource.data.label.size() <= 60
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.type is string && request.resource.data.type.size() <= 100
        && request.resource.data.size is int && request.resource.data.size >= 0 && request.resource.data.size <= 512000
        && request.resource.data.data is string && request.resource.data.data.size() <= 690000;
    }
    match /leaderboard/{entry} {
      allow read: if true;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && request.auth.token.email_verified == true
        && entry == 'neon-2048_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','gameId','nickname','score','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.gameId == 'neon-2048'
        && request.resource.data.nickname is string && request.resource.data.nickname.size() >= 1 && request.resource.data.nickname.size() <= 24
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 1000000000
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/leaderboard/$(entry)) || request.resource.data.score >= resource.data.score);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
